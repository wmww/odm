+
+    /// Build a top-level window that is transient for `parent` (a dialog of
+    /// it): the window manager keeps it above its parent and may place,
+    /// group or minimize it with it. Unlike [`Self::with_parent_window`],
+    /// the window is not embedded in the parent.
+    ///
+    /// ## Safety
+    ///
+    /// `parent` must be a valid window handle, created by this event loop.
+    ///
+    /// ## Platform-specific
+    ///
+    /// - **Windows:** the owner window (as `with_owner_window`).
+    /// - **macOS:** a child window (`addChildWindow`).
+    /// - **X11:** `WM_TRANSIENT_FOR`.
+    /// - **Wayland:** `xdg_toplevel.set_parent`.
+    /// - **Android / iOS / Web / Orbital:** Unsupported.
+    #[cfg(feature = "rwh_06")]
+    #[inline]
+    pub unsafe fn with_transient_parent(mut self, parent: Option<rwh_06::RawWindowHandle>) -> Self {
+        self.transient_parent = parent.map(SendSyncRawWindowHandle);
+        self
+    }
