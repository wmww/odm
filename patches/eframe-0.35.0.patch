+/// The raw handle of each viewport's window, for its children to name as parent.
+fn window_handles(viewports: &Viewports) -> HashMap<ViewportId, raw_window_handle::RawWindowHandle> {
+    viewports
+        .iter()
+        .filter_map(|(id, viewport)| {
+            let handle = viewport.window.as_ref()?.window_handle().ok()?;
+            Some((*id, handle.as_raw()))
+        })
+        .collect()
+}
