{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR:-.}/scripts/shared-target.sh\" 2>/dev/null || true",
            "statusMessage": "Sharing cargo target dir",
            "timeout": 10
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR:-.}/scripts/shared-target.sh\" 2>/dev/null || true",
            "statusMessage": "Sharing cargo target dir",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
